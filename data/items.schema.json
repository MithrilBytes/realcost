{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/realcost/items.schema.json",
  "title": "RealCost item catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "category", "prices", "source", "asOf"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "category": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "short": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      },
      "unitSingular": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "unitPlural": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "prices": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": { "pattern": "^[A-Z]{3}$" },
        "additionalProperties": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "source": {
        "type": "string",
        "pattern": "^https://"
      },
      "sources": {
        "type": "object",
        "propertyNames": { "pattern": "^[A-Z]{3}$" },
        "additionalProperties": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "asOf": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}$"
      },
      "note": {
        "type": "string",
        "maxLength": 400
      }
    }
  }
}
